[Unit]
Description=Bridge Bluetooth AVRCP to MPRIS (headphone transport controls)
Documentation=man:mpris-proxy(1)
After=bluetooth.target
# Without this, headphone play/pause and pause-on-removal have nowhere to go:
# the headphones send the command and nothing on this machine is listening.
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/mpris-proxy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
