#!/usr/bin/env python3
"""Hold the one control session the headphones allow, and lend it out.

The device permits a single MDR session at a time and the handshake costs
several seconds, so nothing short-lived can talk to it: a bar widget that
connected on every refresh would spend its life handshaking and would lock the
phone app out anyway. This daemon owns the session, keeps a picture of the
state, and answers cheap questions about it over a Unix socket.

Stop it (`systemctl --user stop mdrctld`) before using Sony's app.
"""
import json, os, select, socket, sys, time, subprocess, signal, errno

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import mdr

MAC = os.environ.get("MDR_MAC", "00:00:5E:00:53:01")
BUILD = os.environ.get(
    "MDR_BUILD",
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "vendor",
                 "SonyHeadphonesClient", "build"),
)
RUNDIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "mdrctl")
SOCKET = os.path.join(RUNDIR, "sock")
STATE = os.path.join(RUNDIR, "state.json")

# Cycling order for a bar click. Ambient last so a stray click lands on a mode
# you can hear yourself out of.
CYCLE = ["cancelling", "ambient", "off"]


def bluez_path(mac):
    """BlueZ object path for a device, adapter discovered by trying a few."""
    dev = "dev_" + mac.replace(":", "_").upper()
    for i in range(4):
        path = f"/org/bluez/hci{i}/{dev}"
        if bluez_get(path, "org.bluez.Device1", "Connected") is not None:
            return path
    return None


def bluez_get(path, iface, prop):
    """One property, or None. Shelling out beats a D-Bus dependency here: this
    is called once every few seconds, and only while we have no session."""
    try:
        out = subprocess.run(["busctl", "get-property", "org.bluez", path, iface, prop],
                             capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0:
        return None
    parts = out.stdout.split()
    return parts[1] if len(parts) > 1 else None


class Daemon:
    def __init__(self):
        self.lib = mdr.Library(BUILD)
        self.hp = None
        self.path = None
        self.state = {}
        # What we last told the device to do, per field: {field: (value,
        # baseline, when)}. The device does not echo our own writes back to us,
        # so we keep showing what we asked for until its reading actually moves
        # -- that move is the only evidence it has something new to say.
        self.claims = {}
        self.next_attempt = 0.0
        self.backoff = 2.0
        self.error = None
        self._last_write = 0.0
        self._features = {}
        # Connections that asked to be told about changes instead of polling.
        self.subscribers = []

    # -- session ---------------------------------------------------------

    def present(self):
        """Is the headset connected to the machine at all (BlueZ's view)?"""
        if self.path is None:
            self.path = bluez_path(MAC)
            if self.path is None:
                return False
        return bluez_get(self.path, "org.bluez.Device1", "Connected") == "true"

    def bluez_battery(self):
        """Battery without a session. BlueZ gets this from the HFP indicator,
        so the widget still shows a level while the daemon is stopped."""
        v = bluez_get(self.path, "org.bluez.Battery1", "Percentage") if self.path else None
        try:
            return int(v)
        except (TypeError, ValueError):
            return None

    def connect(self):
        if time.monotonic() < self.next_attempt:
            return
        if not self.present():
            self.error = "headset not connected"
            self.next_attempt = time.monotonic() + 5.0
            return
        try:
            hp = mdr.Headphones(self.lib, MAC)
            # This session never closes, and the main loop pumps continuously,
            # so a write does not need to sit and pump before returning. That
            # wait was 200 ms on every single action.
            hp.write_settle = 0.0
            hp.open()
        except mdr.MDRError as e:
            self.error = str(e)
            self.next_attempt = time.monotonic() + self.backoff
            self.backoff = min(self.backoff * 2, 60.0)
            return
        self.hp, self.error, self.backoff = hp, None, 2.0
        self.claims = {}
        try:
            # Fixed for the life of a session, so read them once. A control the
            # device does not advertise is not merely useless: its write is
            # staged, committed locally and never sent, so it looks like it
            # worked and silently did nothing.
            self._features = self.hp.features()
        except mdr.MDRError:
            self._features = {}

    def drop(self, why):
        if self.hp:
            try:
                self.hp.close()
            except Exception:
                pass
        self.hp = None
        self.error = why
        self.claims = {}
        self.next_attempt = time.monotonic() + self.backoff

    # -- state -----------------------------------------------------------

    def refresh(self):
        s = {"updated": time.time(), "mac": MAC,
             "present": bool(self.hp) or self.present(),
             "session": bool(self.hp), "error": self.error}
        if not self.hp:
            s["battery"] = self.bluez_battery()
            s["battery_source"] = "bluez"
            return s
        try:
            batteries = self.hp.get_batteries()
            nc = self.hp.get_noise_control()
        except mdr.MDRError as e:
            self.drop(str(e))
            return self.refresh()

        s["batteries"] = [{"part": mdr.BATTERY_PART.get(b.part, b.part),
                           "level": b.level_percent,
                           "charging": mdr.CHARGING.get(b.charging, b.charging)}
                          for b in batteries]
        main = next((b for b in s["batteries"] if b["part"] == "main"), None) or \
            (s["batteries"][0] if s["batteries"] else None)
        s["battery"] = main["level"] if main else self.bluez_battery()
        s["charging"] = main["charging"] if main else None
        s["battery_source"] = "mdr" if main else "bluez"
        s["features"] = self._features

        # Read the rest best-effort: a device that does not answer one of
        # these should not cost us the battery and the noise mode too.
        try:
            eq = self.hp.get_equalizer()
            bands = self.hp.get_equalizer_bands()
            s["eq_preset"] = mdr.EQ_PRESET.get(eq.preset, eq.preset)
            s["eq_clear_bass"] = eq.clear_bass
            s["eq_bands"] = bands
            s["eq_band_limit"] = mdr.Headphones.BAND_LIMITS.get(len(bands), 10)
            s["dsee"] = bool(eq.dsee_enabled)
            s["dsee_type"] = mdr.DSEE.get(eq.dsee_type, eq.dsee_type)
        except mdr.MDRError:
            pass
        try:
            cm = self.hp.get_connection_mode()
            s["audio_priority"] = mdr.AUDIO_PRIORITY.get(cm.audio_priority, cm.audio_priority)
        except mdr.MDRError:
            pass
        try:
            pw = self.hp.get_power()
            s["auto_power_off"] = pw.auto_power_off_minutes
            s["wearing_power"] = mdr.WEARING_POWER.get(pw.wearing_power, pw.wearing_power)
            s["auto_pause"] = bool(pw.auto_pause)
            # One setting, not two. On a device with wearing detection the
            # library ignores the minutes entirely and stages "off when
            # removed" instead, so presenting them as independent controls
            # makes a write that worked look like one that vanished.
            s["power_off"] = ("when-removed" if s["wearing_power"] == "when-removed"
                              else "never" if not pw.auto_power_off_minutes
                              else str(pw.auto_power_off_minutes))
            s["power_off_choices"] = mdr.POWER_OFF_CHOICES
        except mdr.MDRError:
            pass
        try:
            ls = self.hp.get_listening()
            s["listening"] = mdr.LISTENING_MODE.get(ls.mode, ls.mode)
            s["room_size"] = mdr.ROOM_SIZE.get(ls.background_room, ls.background_room)
        except mdr.MDRError:
            pass

        s["mode"] = mdr.NOISE_MODE.get(nc.mode, nc.mode)
        s["ambient_level"] = nc.ambient_level
        s["ambient_level_max"] = mdr.AMBIENT_LEVEL_MAX
        s["focus_on_voice"] = bool(nc.focus_on_voice)
        s["button_mode"] = mdr.NOISE_BUTTON.get(nc.button_mode, nc.button_mode)
        s["adaptive"] = bool(nc.adaptive_ambient)
        return self.apply_claims(s)

    # A claim that the device never contradicts would otherwise last forever.
    # It should: our value is the true one. But if someone sets the same field
    # back to its old value on the headphones themselves, the reading never
    # moves and we would go on showing a stale claim, so give up after a while.
    CLAIM_TTL = 120.0

    def apply_claims(self, s):
        """Show what we asked for until the device's own reading moves."""
        now = time.monotonic()
        unconfirmed = []
        for field in list(self.claims):
            value, baseline, when = self.claims[field]
            raw = s.get(field)
            if raw != baseline or now - when > self.CLAIM_TTL:
                del self.claims[field]   # the device moved, or we waited enough
                continue
            s[field] = value
            unconfirmed.append(field)
        s["unconfirmed"] = sorted(unconfirmed)
        s["mode_confirmed"] = "mode" not in self.claims
        return s

    def claim(self, field, value):
        """Record what we just wrote, against what the device says right now."""
        baseline = self.state.get(field)
        if field in self.claims:
            baseline = self.claims[field][1]   # keep the pre-claim reading
        self.claims[field] = (value, baseline, time.monotonic())

    def publish(self, s):
        """Write the state file, and keep writing it even when nothing changes.

        `updated` is how a reader tells a live daemon from a stopped one, so a
        file that stops moving has to mean something. Without the heartbeat a
        stale file reads exactly like a healthy one, and a widget goes on
        offering controls that have nobody left to answer them.
        """
        now = time.monotonic()
        unchanged = ({k: v for k, v in s.items() if k != "updated"}
                     == {k: v for k, v in self.state.items() if k != "updated"})
        if unchanged and now - self._last_write < 2.0:
            return
        self.state = s
        self._last_write = now
        tmp = STATE + ".new"
        with open(tmp, "w") as f:
            json.dump(s, f)
        os.replace(tmp, STATE)   # atomic: readers never see half a file
        self.push(s)

    def push(self, s):
        """Tell the subscribers, so a widget does not have to poll for it."""
        if not self.subscribers:
            return
        line = (json.dumps({"state": s}) + "\n").encode()
        for conn in list(self.subscribers):
            try:
                conn.sendall(line)
            except OSError:
                self.drop_subscriber(conn)

    def drop_subscriber(self, conn):
        if conn in self.subscribers:
            self.subscribers.remove(conn)
        try:
            conn.close()
        except OSError:
            pass

    # -- commands --------------------------------------------------------

    def set_mode(self, mode, level=None):
        if self.hp is None:
            return {"ok": False, "error": self.error or "no session"}
        if mode not in mdr.NOISE_MODE_BY_NAME:
            return {"ok": False, "error": f"unknown mode {mode!r}"}
        try:
            nc = self.hp.get_noise_control()
            baseline = self.state.get("mode", mdr.NOISE_MODE.get(nc.mode, nc.mode))
            nc.mode = mdr.NOISE_MODE_BY_NAME[mode]
            if level is not None:
                nc.ambient_level = max(0, min(mdr.AMBIENT_LEVEL_MAX, int(level)))
            self.hp.set_noise_control(nc)
        except mdr.MDRError as e:
            self.drop(str(e))
            return {"ok": False, "error": str(e)}
        # Do not wait for a read-back. The write lands; the echo may never come.
        self.claims["mode"] = (mode, baseline, time.monotonic())
        if level is not None:
            self.claims["ambient_level"] = (
                int(nc.ambient_level), self.state.get("ambient_level"), time.monotonic())
        return {"ok": True, "mode": mode, "confirmed": False}

    def simple(self, action, field=None, value=None):
        """Run a write, claim what it set, and report it done.

        Deliberately no read-back: the device does not echo a session's own
        writes, so confirming one turns a write that worked into an error.
        """
        if self.hp is None:
            return {"ok": False, "error": self.error or "no session"}
        try:
            action()
        except (mdr.MDRError, ValueError) as e:
            if isinstance(e, mdr.MDRError):
                self.drop(str(e))
            return {"ok": False, "error": str(e)}
        if field is not None:
            self.claim(field, value)
        return {"ok": True}

    def set_power_off(self, choice):
        """'when-removed', 'never', or a number of minutes.

        Wearing detection and the timer are alternatives on this device, so
        asking for minutes has to switch wearing detection off in the same
        write, or the library quietly stages the wearing-detection value and
        drops the minutes on the floor.
        """
        pw = self.hp.get_power()
        pw.shutdown_requested = 0
        if choice == "when-removed":
            pw.wearing_power = mdr.WEARING_POWER_BY_NAME["when-removed"]
            pw.auto_power_off_minutes = 0
        else:
            pw.wearing_power = mdr.WEARING_POWER_BY_NAME["disabled"]
            pw.auto_power_off_minutes = 0 if choice == "never" else int(choice)
        return self.hp.set_power(pw)

    def set_auto_pause(self, on):
        pw = self.hp.get_power()
        pw.auto_pause = 1 if on else 0
        pw.shutdown_requested = 0
        return self.hp.set_power(pw)

    def shutdown_headphones(self):
        """The headphones going off takes the link with them, so drop the
        session ourselves rather than waiting to trip over a dead socket."""
        if self.hp is None:
            return {"ok": False, "error": self.error or "no session"}
        try:
            self.hp.shutdown()
        except mdr.MDRError as e:
            self.drop(str(e))
            return {"ok": False, "error": str(e)}
        self.drop("headphones powered off")
        return {"ok": True}

    def handle(self, line):
        parts = line.split()
        if not parts:
            return {"ok": False, "error": "empty command"}
        cmd, args = parts[0], parts[1:]
        if cmd == "status":
            return {"ok": True, "state": self.state}
        if cmd == "mode":
            if not args:
                return {"ok": False, "error": "mode needs a value"}
            return self.set_mode(args[0], args[1] if len(args) > 1 else None)
        if cmd == "cycle":
            now = self.state.get("mode")
            nxt = CYCLE[(CYCLE.index(now) + 1) % len(CYCLE)] if now in CYCLE else CYCLE[0]
            return self.set_mode(nxt)
        if cmd == "ambient":
            if not args:
                return {"ok": False, "error": "ambient needs a level"}
            return self.set_mode("ambient", args[0])
        if cmd == "eq":
            if not args:
                return {"ok": False, "error": "eq needs a preset name"}
            return self.simple(lambda: self.hp.set_eq_preset(args[0]), "eq_preset", args[0])
        if cmd == "bands":
            if len(args) == 1:
                args = args[0].split(",")
            return self.simple(lambda: self.hp.write_eq(bands=args),
                               "eq_bands", [int(v) for v in args])
        if cmd == "clear-bass":
            if not args:
                return {"ok": False, "error": "clear-bass needs a level"}
            return self.simple(lambda: self.hp.set_clear_bass(args[0]),
                               "eq_clear_bass", int(args[0]))
        if cmd == "dsee":
            if not args or args[0] not in ("on", "off"):
                return {"ok": False, "error": "dsee takes on or off"}
            return self.simple(lambda: self.hp.set_dsee(args[0] == "on"),
                               "dsee", args[0] == "on")
        if cmd == "priority":
            if not args:
                return {"ok": False, "error": "priority takes quality or stability"}
            return self.simple(lambda: self.hp.set_audio_priority(args[0]),
                               "audio_priority", args[0])
        if cmd == "listening":
            if not args:
                return {"ok": False, "error": "listening needs a mode"}
            room = args[1] if len(args) > 1 else None
            return self.simple(lambda: self.hp.set_listening_mode(args[0], room),
                               "listening", args[0])
        if cmd == "power-off":
            if not args or args[0] not in mdr.POWER_OFF_CHOICES:
                return {"ok": False,
                        "error": "power-off takes one of " + ", ".join(mdr.POWER_OFF_CHOICES)}
            return self.simple(lambda: self.set_power_off(args[0]), "power_off", args[0])
        if cmd == "auto-pause":
            if not args or args[0] not in ("on", "off"):
                return {"ok": False, "error": "auto-pause takes on or off"}
            return self.simple(lambda: self.set_auto_pause(args[0] == "on"),
                               "auto_pause", args[0] == "on")
        if cmd == "shutdown":
            return self.shutdown_headphones()
        if cmd == "reconnect":
            self.drop("reconnect requested")
            self.next_attempt = 0.0
            return {"ok": True}
        if cmd == "ping":
            return {"ok": True}
        return {"ok": False, "error": f"unknown command {cmd!r}"}

    # -- loop ------------------------------------------------------------

    def run(self):
        os.makedirs(RUNDIR, exist_ok=True)
        if os.path.exists(SOCKET):
            os.unlink(SOCKET)
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SOCKET)
        srv.listen(16)
        srv.setblocking(False)

        stop = []
        for sig in (signal.SIGINT, signal.SIGTERM):
            signal.signal(sig, lambda *_: stop.append(True))

        buffers = {}
        last_refresh = 0.0
        while not stop:
            if self.hp is None:
                self.connect()

            if self.hp:
                try:
                    self.hp.pump(20)
                except Exception as e:
                    self.drop(str(e))
            else:
                time.sleep(0.25)

            ready, _, _ = select.select([srv] + self.subscribers, [], [], 0)
            dirty = False
            for sock in ready:
                if sock is srv:
                    try:
                        conn, _ = srv.accept()
                    except OSError as e:
                        if e.errno not in (errno.EAGAIN, errno.EWOULDBLOCK):
                            raise
                        continue
                    if self.serve(conn):
                        dirty = True
                else:
                    if self.serve_subscriber(sock, buffers):
                        dirty = True

            now = time.monotonic()
            # A command's effect should show immediately, not on the next tick.
            if dirty or now - last_refresh >= 0.2:
                last_refresh = now
                self.publish(self.refresh())

        srv.close()
        for conn in list(self.subscribers):
            self.drop_subscriber(conn)
        for p in (SOCKET, STATE):
            try:
                os.unlink(p)
            except OSError:
                pass
        if self.hp:
            self.hp.close()

    def serve_subscriber(self, conn, buffers):
        """A held-open connection: further lines on it are commands."""
        try:
            chunk = conn.recv(4096)
        except OSError:
            self.drop_subscriber(conn)
            return False
        if not chunk:
            self.drop_subscriber(conn)
            return False
        buf = buffers.get(conn, b"") + chunk
        acted = False
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            text = line.decode(errors="replace").strip()
            if not text:
                continue
            reply = self.handle(text)
            acted = True
            try:
                conn.sendall((json.dumps(reply) + "\n").encode())
            except OSError:
                self.drop_subscriber(conn)
                buffers.pop(conn, None)
                return acted
        buffers[conn] = buf
        return acted

    def serve(self, conn):
        """One request on a fresh connection. `subscribe` keeps it open and
        turns it into a push channel, which is what the bar widget uses so it
        never has to poll."""
        try:
            conn.settimeout(2.0)
            line = conn.recv(4096).decode(errors="replace").strip()
        except (OSError, UnicodeDecodeError):
            conn.close()
            return False

        if line == "subscribe":
            conn.settimeout(None)
            conn.setblocking(False)
            self.subscribers.append(conn)
            try:
                conn.sendall((json.dumps({"state": self.state}) + "\n").encode())
            except OSError:
                self.drop_subscriber(conn)
            return False

        with conn:
            reply = self.handle(line)
            if reply.get("ok") and line.split()[:1] != ["status"]:
                reply["state"] = self.refresh()
            try:
                conn.sendall((json.dumps(reply) + "\n").encode())
            except OSError:
                pass
        return reply.get("ok", False)


if __name__ == "__main__":
    Daemon().run()
