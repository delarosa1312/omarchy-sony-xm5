#!/usr/bin/env python3
"""Hold the one control session the headphones allow, and lend it out.

The device permits a single MDR session at a time and the handshake costs
several seconds, so nothing short-lived can talk to it: a bar widget that
connected on every refresh would spend its life handshaking and would lock the
phone app out anyway. This daemon owns the session, keeps a picture of the
state, and answers cheap questions about it over a Unix socket.

Stop it (`systemctl --user stop mdrctld`) before using Sony's app.
"""
import argparse, errno, json, os, select, signal, socket, stat, subprocess, sys, time

# A checkout keeps the module in ../lib; the package puts it beside the
# shared objects it loads. Both are offered, and the import takes whichever
# is really there.
_here = os.path.dirname(os.path.abspath(__file__))
sys.path[:0] = [os.path.join(_here, "..", "lib"), "/usr/lib/mdrctl"]
import mdr

# The service a Sony device offers if it speaks MDR at all. This is how the
# headphones are recognised -- by what they can do rather than by address --
# and it is the same UUID the session is opened on.
MDR_UUID = "956c7b26-d49a-4ba8-b03f-b17d393cb6e2"

# Everything below used to be read from the environment, which a long-lived
# service simply inherits. MDR_BUILD was the sharp one: it chose which shared
# objects to dlopen, and it was consulted before the packaged location, so
# anything able to set the daemon's environment chose the code it ran. These
# are command-line arguments now, because an argument is something the unit
# states and an environment is something it is handed.
MAC = ""
BUILD = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..",
                     "vendor", "SonyHeadphonesClient", "build")
TRACE = ""

# XDG_RUNTIME_DIR stays: it is how a user session tells a service where its
# private directory is, and there is no other way to learn it. What changes is
# that the directory it names is verified and then held open, so every later
# operation goes through that descriptor rather than re-walking a path that
# something else may have altered in between. See open_rundir().
RUNDIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "mdrctl")
SOCKET = os.path.join(RUNDIR, "sock")
STATE = os.path.join(RUNDIR, "state.json")
STATE_NAME = "state.json"
STATE_TMP_NAME = "state.json.new"
SOCKET_NAME = "sock"

# External tools, by absolute path. Resolving `busctl` through an inherited
# PATH lets whatever the service was handed decide which binary it runs.
BUSCTL_CANDIDATES = ("/usr/bin/busctl", "/bin/busctl")

# busctl's reply is the only thing read from it, and GetManagedObjects on a
# machine with many paired devices is large but bounded. A ceiling turns a
# runaway or hostile reply into an error instead of into the daemon's memory.
MAX_TOOL_OUTPUT = 4 * 1024 * 1024

# What one client may make the daemon hold. A subscriber is long-lived and
# mostly silent, so the useful limits are on bytes and connections rather than
# on idleness -- an unterminated line is what grows without bound, and a
# partial line that stops arriving is the shape of that abuse.
MAX_LINE = 64 * 1024
MAX_CLIENTS = 32
PARTIAL_LINE_WAIT = 30.0


def busctl_path():
    """The busctl to run, or None. Fixed locations only, and it must be a
    regular executable file -- not a symlink chain we did not follow."""
    for cand in BUSCTL_CANDIDATES:
        try:
            st = os.stat(cand)
        except OSError:
            continue
        if stat.S_ISREG(st.st_mode) and os.access(cand, os.X_OK):
            return cand
    return None


BUSCTL = busctl_path()


def run_tool(argv, timeout=5):
    """Run a trusted tool and return its stdout, or None.

    Reads through a pipe with a ceiling rather than capture_output=True, which
    would buffer whatever the child decided to produce.
    """
    if not BUSCTL:
        return None
    try:
        proc = subprocess.Popen(argv, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, env={"LC_ALL": "C"})
    except OSError:
        return None
    try:
        out = proc.stdout.read(MAX_TOOL_OUTPUT + 1)
        if len(out) > MAX_TOOL_OUTPUT:
            proc.kill()
            proc.wait()
            return None
        if proc.wait(timeout=timeout) != 0:
            return None
    except (OSError, subprocess.TimeoutExpired):
        proc.kill()
        proc.wait()
        return None
    finally:
        proc.stdout.close()
    return out.decode("utf-8", errors="replace")


def open_rundir():
    """Create the runtime directory, check it, and hold it open.

    Holding a descriptor is the point. Every later create, replace and unlink
    names a file *inside this directory object* instead of re-walking
    "$XDG_RUNTIME_DIR/mdrctl/..." each time, so nothing can swap a component
    of that path for a symlink between one operation and the next. O_NOFOLLOW
    means we fail rather than follow if the directory itself is already one.
    """
    os.makedirs(RUNDIR, mode=0o700, exist_ok=True)
    fd = os.open(RUNDIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    st = os.fstat(fd)
    if st.st_uid != os.getuid():
        os.close(fd)
        sys.exit(f"{RUNDIR} belongs to uid {st.st_uid}, not {os.getuid()}")
    if stat.S_IMODE(st.st_mode) & 0o077:
        os.fchmod(fd, 0o700)
    return fd

# Cycling order for a bar click. Ambient last so a stray click lands on a mode
# you can hear yourself out of.
CYCLE = ["cancelling", "ambient", "off"]


def bluez_path(mac):
    """BlueZ object path for a device, adapter discovered by trying a few."""
    dev = "dev_" + mac.replace(":", "_").upper()
    for i in range(4):
        path = f"/org/bluez/hci{i}/{dev}"
        if bluez_get(path, "org.bluez.Device1", "Connected") is not None:
            return path
    return None


def bluez_devices():
    """Every device BlueZ knows, in one call. Asking for the whole tree at once
    beats a property read per device: this runs while we are looking for a
    headset to talk to, which is exactly when nothing else is happening."""
    out = run_tool([BUSCTL, "--json=short", "call", "org.bluez", "/",
                    "org.freedesktop.DBus.ObjectManager", "GetManagedObjects"])
    if out is None:
        return {}
    try:
        objects = json.loads(out)["data"][0]
    except (ValueError, KeyError, IndexError):
        return {}
    found = {}
    for path, ifaces in objects.items():
        dev = ifaces.get("org.bluez.Device1")
        if not dev:
            continue
        def field(name, fallback=None):
            entry = dev.get(name)
            return entry.get("data", fallback) if isinstance(entry, dict) else fallback
        found[path] = {
            "mac": str(field("Address", "")).upper(),
            "name": str(field("Name", "") or field("Alias", "")),
            "connected": field("Connected", False) is True,
            "uuids": [str(u).lower() for u in (field("UUIDs", []) or [])],
        }
    return found


def headline_battery(batteries):
    """The one reading that stands for the device.

    A headset has a single battery and there is nothing to choose. Earbuds
    report three, and the one that ends the listening is the emptier of the two
    being worn -- so never the first in the list, which is the left bud and
    would quietly hide a right one about to die, and never the case, which is
    not being worn at all.
    """
    worn = [b for b in batteries if b.get("part") in ("main", "left", "right")]
    return min(worn, key=lambda b: b["level"]) if worn else None


def find_headphones(pinned=""):
    """The connected device that speaks MDR. Recognising the headphones by the
    service they offer rather than by a hard-coded address means a pair this
    has never seen -- a second Sony set, a replacement -- works on sight."""
    for path, dev in sorted(bluez_devices().items()):
        if not dev["connected"] or MDR_UUID not in dev["uuids"]:
            continue
        if pinned and dev["mac"] != pinned.upper():
            continue
        return path, dev
    return None, None


def bluez_get(path, iface, prop):
    """One property, or None. Shelling out beats a D-Bus dependency here: this
    is called once every few seconds, and only while we have no session."""
    out = run_tool([BUSCTL, "get-property", "org.bluez", path, iface, prop])
    if out is None:
        return None
    parts = out.split()
    return parts[1] if len(parts) > 1 else None


class Daemon:
    def __init__(self):
        self.lib = mdr.Library(BUILD)
        # Opened in run(); every state and socket operation goes through it.
        self.dirfd = None
        # conn -> when an incomplete command line first appeared on it.
        self.partial = {}
        self.hp = None
        self.path = None
        # Filled in by present(), which is what decides who we are talking to.
        self.mac = MAC
        self.model = ""
        self.state = {}
        # What we last told the device to do, per field: {field: (value,
        # baseline, when)}. The device does not echo our own writes back to us,
        # so we keep showing what we asked for until its reading actually moves
        # -- that move is the only evidence it has something new to say.
        self.claims = {}
        self.next_attempt = 0.0
        self.backoff = 2.0
        self.error = None
        self._last_write = 0.0
        self._last_liveness = 0.0
        self._features = {}
        self._setting_index = {}
        self._adapter_mac = None
        # Connections that asked to be told about changes instead of polling.
        self.subscribers = []
        # Frames the device has acknowledged. The protocol does answer every
        # command -- the library waits for that ACK and retries without it --
        # it just never surfaced it, so writes looked unverifiable when the
        # headphones had been replying all along.
        self.acks = 0
        # A command the device does not acknowledge is resent with the sequence
        # bit flipped, which costs a full second each time. Counting those makes
        # the tax visible instead of merely felt.
        self.retransmits = 0
        self._last_tx = None
        # Values we have written lately, per field. The device echoes a write
        # back a fraction of a second later -- often after the *next* write has
        # already gone out -- and that late echo must not be mistaken for
        # someone turning a dial on the headset.
        self.recent = {}
        self._trace = open(TRACE, "a", buffering=1) if TRACE else None
        self._t0 = time.monotonic()

    # -- session ---------------------------------------------------------

    def present(self):
        """Is a headset connected to the machine at all (BlueZ's view)?

        While a session is up this is one cheap property read on the device we
        already hold. With no session it is a full look around, because the
        pair that is on now may not be the pair that was on last time.
        """
        if self.path is not None and self.hp is not None:
            return bluez_get(self.path, "org.bluez.Device1", "Connected") == "true"
        path, dev = find_headphones(MAC)
        if path is None:
            return False
        if path != self.path:
            self.path, self._adapter_mac = path, None
        self.mac, self.model = dev["mac"], dev["name"]
        return True

    def adapter_mac(self):
        """This machine's own Bluetooth address, so it can be told apart from
        the phone in the headset's list of who it is connected to."""
        if self._adapter_mac is None and self.path:
            value = bluez_get(self.path.rsplit("/", 1)[0], "org.bluez.Adapter1", "Address")
            self._adapter_mac = (value or "").strip('"').upper()
        return self._adapter_mac or ""

    def bluez_battery(self):
        """Battery without a session. BlueZ gets this from the HFP indicator,
        so the widget still shows a level while the daemon is stopped."""
        v = bluez_get(self.path, "org.bluez.Battery1", "Percentage") if self.path else None
        try:
            return int(v)
        except (TypeError, ValueError):
            return None

    def connect(self):
        if time.monotonic() < self.next_attempt:
            return
        if not self.present():
            self.error = "headset not connected"
            self.next_attempt = time.monotonic() + 5.0
            return
        try:
            hp = mdr.Headphones(self.lib, self.mac)
            # This session never closes, and the main loop pumps continuously,
            # so a write does not need to sit and pump before returning. That
            # wait was 200 ms on every single action.
            hp.write_settle = 0.0
            hp.open()
            hp.watch_packets(self.on_packet)
        except mdr.MDRError as e:
            self.error = self.explain(str(e))
            self.next_attempt = time.monotonic() + self.backoff
            self.backoff = min(self.backoff * 2, 60.0)
            return
        self.hp, self.error, self.backoff = hp, None, 2.0
        self.claims = {}
        try:
            # Fixed for the life of a session, so read them once. A control the
            # device does not advertise is not merely useless: its write is
            # staged, committed locally and never sent, so it looks like it
            # worked and silently did nothing.
            self._features = self.hp.features()
        except mdr.MDRError:
            self._features = {}
        self._setting_index = {}
        self._adapter_mac = None

    def trace(self, kind, detail):
        if self._trace:
            self._trace.write(f"{time.monotonic() - self._t0:8.3f}  {kind:<9} {detail}\n")

    def on_packet(self, direction, frame):
        if len(frame) < 3:
            return
        if direction == mdr.PACKET_RX:
            if frame[1] == mdr.DATA_TYPE_ACK:
                self.acks += 1
                self.trace("rx-ack", "")
            else:
                self.trace("rx", f"type={frame[1]:<3} {frame.hex()}")
            return
        if frame[1] != mdr.DATA_TYPE_ACK:
            self.trace("tx", f"type={frame[1]:<3} {frame.hex()}")
        if frame[1] == mdr.DATA_TYPE_ACK:
            return                        # our own acknowledgement of their frame
        # Same payload going out again means the first attempt went unanswered.
        body = frame[2:]
        if self._last_tx is not None and self._last_tx[2:] == body[:len(self._last_tx) - 2]:
            self.retransmits += 1
        self._last_tx = frame

    @staticmethod
    def explain(error):
        """Turn the transport's wording into the thing that is actually wrong.

        The headset allows one control session across every device it is paired
        with, so with multipoint on, a phone holding that session leaves this
        one nothing to connect to. The RFCOMM layer reports that as EBUSY,
        which tells the user nothing at all.
        """
        # Both wordings mean the same thing in practice: the headset would not
        # give us its control channel. It allows one across every device it is
        # paired with, so a phone it is also connected to can be holding it --
        # Sony's app does not have to be open for that.
        low = error.lower()
        if "busy" in low or "timed out" in low or "timeout" in low:
            return ("the headset would not hand over its control channel -- it "
                    "allows one at a time, and another paired device may have it")
        return error

    def drop(self, why):
        if self.hp:
            try:
                self.hp.close()
            except Exception:
                pass
        self.hp = None
        self.error = why
        self.claims = {}
        # What we lately wrote to the pair that just went away says nothing
        # about the pair that comes next. Kept, it would let a value written
        # to the headphones suppress a genuine reading from the buds.
        self.recent = {}
        self.next_attempt = time.monotonic() + self.backoff

    # -- state -----------------------------------------------------------

    LIVENESS_EVERY = 3.0
    # How long the loop sleeps per turn: short enough that a frame from the
    # headset is picked up imperceptibly fast, long enough to cost nothing.
    IDLE_WAIT = 0.02
    # Nothing to pump while there is no session; just do not hammer connect().
    RETRY_WAIT = 0.25
    # How long a connection may sit there having said nothing before it is
    # dropped. Nothing waits on this -- it is a deadline, not a pause.
    REQUEST_WAIT = 2.0

    def refresh(self):
        # Having a session object is not the same as having a link. The library
        # answers every read from its own cache, with no error, long after the
        # headphones have been switched off -- so the widget went on showing a
        # live headset and offering controls for it. BlueZ is the one that
        # actually knows, so ask it on a slow cadence.
        if self.hp and time.monotonic() - self._last_liveness > self.LIVENESS_EVERY:
            self._last_liveness = time.monotonic()
            if not self.present():
                self.drop("headphones disconnected")

        # present() is what discovers the headphones, so call it before
        # reporting who they are -- otherwise the first state published after
        # a new pair connects still carries the old pair's name.
        here = bool(self.hp) or self.present()
        s = {"updated": time.time(), "mac": self.mac, "model": self.model,
             "present": here, "session": bool(self.hp), "error": self.error}
        if not self.hp:
            s["battery"] = self.bluez_battery()
            s["battery_source"] = "bluez"
            return s
        try:
            batteries = self.hp.get_batteries()
            nc = self.hp.get_noise_control()
        except mdr.MDRError as e:
            self.drop(str(e))
            return self.refresh()

        s["batteries"] = [{"part": mdr.BATTERY_PART.get(b.part, b.part),
                           "level": b.level_percent,
                           "charging": mdr.CHARGING.get(b.charging, b.charging)}
                          for b in batteries]
        main = headline_battery(s["batteries"])
        s["battery"] = main["level"] if main else self.bluez_battery()
        s["charging"] = main["charging"] if main else None
        s["battery_source"] = "mdr" if main else "bluez"
        s["features"] = self._features

        # Read the rest best-effort: a device that does not answer one of
        # these should not cost us the battery and the noise mode too.
        try:
            eq = self.hp.get_equalizer()
            bands = self.hp.get_equalizer_bands()
            s["eq_preset"] = mdr.EQ_PRESET.get(eq.preset, eq.preset)
            s["eq_clear_bass"] = eq.clear_bass
            s["eq_bands"] = bands
            s["eq_band_limit"] = mdr.Headphones.BAND_LIMITS.get(len(bands), 10)
            s["dsee"] = bool(eq.dsee_enabled)
            s["dsee_type"] = mdr.DSEE.get(eq.dsee_type, eq.dsee_type)
        except mdr.MDRError:
            pass
        try:
            cm = self.hp.get_connection_mode()
            s["audio_priority"] = mdr.AUDIO_PRIORITY.get(cm.audio_priority, cm.audio_priority)
        except mdr.MDRError:
            pass
        try:
            pw = self.hp.get_power()
            s["auto_power_off"] = pw.auto_power_off_minutes
            s["wearing_power"] = mdr.WEARING_POWER.get(pw.wearing_power, pw.wearing_power)
            s["auto_pause"] = bool(pw.auto_pause)
            # One setting, not two. On a device with wearing detection the
            # library ignores the minutes entirely and stages "off when
            # removed" instead, so presenting them as independent controls
            # makes a write that worked look like one that vanished.
            s["power_off"] = ("when-removed" if s["wearing_power"] == "when-removed"
                              else "never" if not pw.auto_power_off_minutes
                              else str(pw.auto_power_off_minutes))
            s["power_off_choices"] = mdr.POWER_OFF_CHOICES
        except mdr.MDRError:
            pass
        try:
            ls = self.hp.get_listening()
            s["listening"] = mdr.LISTENING_MODE.get(ls.mode, ls.mode)
            s["room_size"] = mdr.ROOM_SIZE.get(ls.background_room, ls.background_room)
        except mdr.MDRError:
            pass
        try:
            settings = self.hp.general_settings()
            self._setting_index = {k: v["index"] for k, v in settings.items()}
            for name, entry in settings.items():
                s[name] = entry["value"]
        except mdr.MDRError:
            pass
        try:
            # The headset's own view of who it is talking to. This is the only
            # way to see the phone from here -- BlueZ knows nothing about the
            # headset's other links.
            devices = self.hp.paired_devices()
            s["devices"] = devices
            mine = self.adapter_mac()
            # Published so the panel can tell this machine's row apart and
            # withhold the actions that would cut its own link.
            s["self_mac"] = mine
            s["others_connected"] = sorted(
                d["name"] or d["mac"] for d in devices
                if d["connected"] and d["mac"].upper() not in (self.mac.upper(), mine))
        except mdr.MDRError:
            pass

        s["mode"] = mdr.NOISE_MODE.get(nc.mode, nc.mode)
        s["ambient_level"] = nc.ambient_level
        s["ambient_level_max"] = mdr.AMBIENT_LEVEL_MAX
        s["focus_on_voice"] = bool(nc.focus_on_voice)
        s["button_mode"] = mdr.NOISE_BUTTON.get(nc.button_mode, nc.button_mode)
        s["adaptive"] = bool(nc.adaptive_ambient)
        return self.apply_claims(s)

    # A claim that the device never contradicts would otherwise last forever.
    # It should: our value is the true one. But if someone sets the same field
    # back to its old value on the headphones themselves, the reading never
    # moves and we would go on showing a stale claim, so give up after a while.
    CLAIM_TTL = 120.0

    def apply_claims(self, s):
        """Show what we asked for until the device's own reading moves."""
        now = time.monotonic()
        unconfirmed, unacked = [], []
        for field in list(self.claims):
            value, baseline, when, acks_at_write = self.claims[field]
            raw = s.get(field)
            if raw == value or now - when > self.CLAIM_TTL:
                del self.claims[field]   # confirmed, or we have waited enough
                continue
            if raw != baseline and not self.ours(field, raw):
                del self.claims[field]   # a real change, made on the headset
                continue
            s[field] = value
            unconfirmed.append(field)
            # Writes are serialised here, so the next ACK after one belongs to
            # it. Not a guarantee of *what* the device did with the command --
            # a preset write is acknowledged and ignored -- only that the
            # command arrived. Silence, though, means it did not.
            if self.acks <= acks_at_write and now - when > 1.0:
                unacked.append(field)
        s["unconfirmed"] = sorted(unconfirmed)
        s["unacknowledged"] = sorted(unacked)
        s["acks"] = self.acks
        s["retransmits"] = self.retransmits
        s["mode_confirmed"] = "mode" not in self.claims
        return s

    RECENT_TTL = 8.0

    def claim(self, field, value):
        """Record what we just wrote, against what the device says right now."""
        baseline = self.state.get(field)
        if field in self.claims:
            baseline = self.claims[field][1]   # keep the pre-claim reading
        self.claims[field] = (value, baseline, time.monotonic(), self.acks)
        now = time.monotonic()
        history = [(v, t) for v, t in self.recent.get(field, []) if now - t < self.RECENT_TTL]
        history.append((value, now))
        if baseline is not None:
            history.append((baseline, now))
        self.recent[field] = history

    def ours(self, field, raw):
        """Is this reading just the device repeating something we wrote?"""
        now = time.monotonic()
        return any(v == raw and now - t < self.RECENT_TTL
                   for v, t in self.recent.get(field, []))

    def publish(self, s):
        """Write the state file, and keep writing it even when nothing changes.

        `updated` is how a reader tells a live daemon from a stopped one, so a
        file that stops moving has to mean something. Without the heartbeat a
        stale file reads exactly like a healthy one, and a widget goes on
        offering controls that have nobody left to answer them.
        """
        now = time.monotonic()
        unchanged = ({k: v for k, v in s.items() if k != "updated"}
                     == {k: v for k, v in self.state.items() if k != "updated"})
        if unchanged and now - self._last_write < 2.0:
            return
        if self._trace and s.get("session"):
            prev = self.state
            if (s.get("eq_bands") != prev.get("eq_bands")
                    or s.get("eq_clear_bass") != prev.get("eq_clear_bass")
                    or s.get("mode") != prev.get("mode")
                    or s.get("auto_pause") != prev.get("auto_pause")):
                self.trace("publish",
                           f"bands={s.get('eq_bands')} bass={s.get('eq_clear_bass')} "
                           f"mode={s.get('mode')} claims={sorted(self.claims)}")
        self.state = s
        self._last_write = now
        self.write_state(s)
        self.push(s)

    def write_state(self, s):
        """Write state.json through the held directory descriptor.

        O_EXCL on the temp file means we create it or we fail -- we never write
        through a name something else already put there. os.replace stays
        atomic, so a reader still sees the old file or the new one and never a
        half-written one; it just resolves both names relative to the verified
        directory now.
        """
        blob = json.dumps(s).encode()
        try:
            os.unlink(STATE_TMP_NAME, dir_fd=self.dirfd)
        except FileNotFoundError:
            pass
        fd = os.open(STATE_TMP_NAME,
                     os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                     0o600, dir_fd=self.dirfd)
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(blob)
        except Exception:
            try:
                os.unlink(STATE_TMP_NAME, dir_fd=self.dirfd)
            except OSError:
                pass
            raise
        os.replace(STATE_TMP_NAME, STATE_NAME,
                   src_dir_fd=self.dirfd, dst_dir_fd=self.dirfd)

    def push(self, s):
        """Tell the subscribers, so a widget does not have to poll for it."""
        if not self.subscribers:
            return
        line = (json.dumps({"state": s}) + "\n").encode()
        for conn in list(self.subscribers):
            try:
                conn.sendall(line)
            except OSError:
                self.drop_subscriber(conn)

    def drop_subscriber(self, conn):
        if conn in self.subscribers:
            self.subscribers.remove(conn)
        self.partial.pop(conn, None)
        try:
            conn.close()
        except OSError:
            pass

    # -- commands --------------------------------------------------------

    def set_mode(self, mode, level=None):
        if self.hp is None:
            return {"ok": False, "error": self.error or "no session"}
        if mode not in mdr.NOISE_MODE_BY_NAME:
            return {"ok": False, "error": f"unknown mode {mode!r}"}
        try:
            nc = self.hp.get_noise_control()
            baseline = self.state.get("mode", mdr.NOISE_MODE.get(nc.mode, nc.mode))
            nc.mode = mdr.NOISE_MODE_BY_NAME[mode]
            if level is not None:
                nc.ambient_level = max(0, min(mdr.AMBIENT_LEVEL_MAX, int(level)))
            self.hp.set_noise_control(nc)
        except mdr.MDRError as e:
            self.drop(str(e))
            return {"ok": False, "error": str(e)}
        # Do not wait for a read-back. The write lands; the echo may never come.
        self.claim("mode", mode)
        self.claims["mode"] = (mode, baseline, time.monotonic(), self.claims["mode"][3])
        if level is not None:
            self.claim("ambient_level", int(nc.ambient_level))
        return {"ok": True, "mode": mode, "confirmed": False}

    def simple(self, action, field=None, value=None):
        """Run a write, claim what it set, and report it done.

        Deliberately no read-back: the device does not echo a session's own
        writes, so confirming one turns a write that worked into an error.
        """
        if self.hp is None:
            return {"ok": False, "error": self.error or "no session"}
        try:
            action()
        except (mdr.MDRError, ValueError) as e:
            if isinstance(e, mdr.MDRError):
                self.drop(str(e))
            return {"ok": False, "error": str(e)}
        if field is not None:
            self.claim(field, value)
        return {"ok": True}

    def set_power_off(self, choice):
        """'when-removed', 'never', or a number of minutes.

        Wearing detection and the timer are alternatives on this device, so
        asking for minutes has to switch wearing detection off in the same
        write, or the library quietly stages the wearing-detection value and
        drops the minutes on the floor.
        """
        pw = self.hp.get_power()
        pw.shutdown_requested = 0
        if choice == "when-removed":
            pw.wearing_power = mdr.WEARING_POWER_BY_NAME["when-removed"]
            pw.auto_power_off_minutes = 0
        else:
            pw.wearing_power = mdr.WEARING_POWER_BY_NAME["disabled"]
            pw.auto_power_off_minutes = 0 if choice == "never" else int(choice)
        return self.hp.set_power(pw)

    def set_auto_pause(self, on):
        pw = self.hp.get_power()
        pw.auto_pause = 1 if on else 0
        pw.shutdown_requested = 0
        return self.hp.set_power(pw)

    def shutdown_headphones(self):
        """The headphones going off takes the link with them, so drop the
        session ourselves rather than waiting to trip over a dead socket."""
        if self.hp is None:
            return {"ok": False, "error": self.error or "no session"}
        try:
            self.hp.shutdown()
        except mdr.MDRError as e:
            self.drop(str(e))
            return {"ok": False, "error": str(e)}
        self.drop("headphones powered off")
        return {"ok": True}

    def handle(self, line):
        self.trace("command", line)
        parts = line.split()
        if not parts:
            return {"ok": False, "error": "empty command"}
        cmd, args = parts[0], parts[1:]
        if cmd == "status":
            return {"ok": True, "state": self.state}
        if cmd == "mode":
            if not args:
                return {"ok": False, "error": "mode needs a value"}
            return self.set_mode(args[0], args[1] if len(args) > 1 else None)
        if cmd == "cycle":
            now = self.state.get("mode")
            nxt = CYCLE[(CYCLE.index(now) + 1) % len(CYCLE)] if now in CYCLE else CYCLE[0]
            return self.set_mode(nxt)
        if cmd == "ambient":
            if not args:
                return {"ok": False, "error": "ambient needs a level"}
            return self.set_mode("ambient", args[0])
        if cmd == "eq":
            if not args:
                return {"ok": False, "error": "eq needs a preset name"}
            return self.simple(lambda: self.hp.set_eq_preset(args[0]), "eq_preset", args[0])
        if cmd == "bands":
            if len(args) == 1:
                args = args[0].split(",")
            return self.simple(lambda: self.hp.set_bands(args),
                               "eq_bands", [int(v) for v in args])
        if cmd == "clear-bass":
            if not args:
                return {"ok": False, "error": "clear-bass needs a level"}
            return self.simple(lambda: self.hp.set_clear_bass(args[0]),
                               "eq_clear_bass", int(args[0]))
        if cmd == "dsee":
            if not args or args[0] not in ("on", "off"):
                return {"ok": False, "error": "dsee takes on or off"}
            return self.simple(lambda: self.hp.set_dsee(args[0] == "on"),
                               "dsee", args[0] == "on")
        if cmd == "priority":
            if not args:
                return {"ok": False, "error": "priority takes quality or stability"}
            return self.simple(lambda: self.hp.set_audio_priority(args[0]),
                               "audio_priority", args[0])
        if cmd == "listening":
            if not args:
                return {"ok": False, "error": "listening needs a mode"}
            room = args[1] if len(args) > 1 else None
            return self.simple(lambda: self.hp.set_listening_mode(args[0], room),
                               "listening", args[0])
        if cmd == "power-off":
            if not args or args[0] not in mdr.POWER_OFF_CHOICES:
                return {"ok": False,
                        "error": "power-off takes one of " + ", ".join(mdr.POWER_OFF_CHOICES)}
            return self.simple(lambda: self.set_power_off(args[0]), "power_off", args[0])
        if cmd == "auto-pause":
            if not args or args[0] not in ("on", "off"):
                return {"ok": False, "error": "auto-pause takes on or off"}
            return self.simple(lambda: self.set_auto_pause(args[0] == "on"),
                               "auto_pause", args[0] == "on")
        if cmd == "shutdown":
            return self.shutdown_headphones()
        if cmd in ("multipoint", "touch-panel"):
            field = cmd.replace("-", "_")
            if not args or args[0] not in ("on", "off"):
                return {"ok": False, "error": f"{cmd} takes on or off"}
            index = self._setting_index.get(field)
            if index is None:
                return {"ok": False, "error": f"this device has no {field} setting"}
            want = args[0] == "on"
            return self.simple(lambda: self.hp.set_general_setting(index, want),
                               field, want)
        if cmd == "device":
            if len(args) < 2 or args[0] not in mdr.PAIRED_COMMAND:
                return {"ok": False,
                        "error": "device takes connect|disconnect|playback|unpair and a MAC"}
            action, mac = args[0], args[1]
            return self.simple(lambda: self.hp.paired_device_action(action, mac))
        if cmd == "reconnect":
            self.drop("reconnect requested")
            self.next_attempt = 0.0
            return {"ok": True}
        if cmd == "ping":
            return {"ok": True}
        return {"ok": False, "error": f"unknown command {cmd!r}"}

    # -- loop ------------------------------------------------------------

    def run(self):
        self.dirfd = open_rundir()
        # A stale socket of ours is ours to clear. Anything else wearing that
        # name is not, and removing it blindly is how a daemon deletes a file
        # somebody else put there on purpose.
        try:
            st = os.lstat(SOCKET_NAME, dir_fd=self.dirfd)
            if not stat.S_ISSOCK(st.st_mode):
                sys.exit(f"{SOCKET} exists and is not a socket; refusing to replace it")
            os.unlink(SOCKET_NAME, dir_fd=self.dirfd)
        except FileNotFoundError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        # bind() takes a path and has no dir_fd form, so bind relative to the
        # verified directory and step straight back out. The umask keeps the
        # socket owner-only even though the directory is already 0700.
        here = os.open(".", os.O_RDONLY | os.O_DIRECTORY)
        old_umask = os.umask(0o077)
        try:
            os.fchdir(self.dirfd)
            srv.bind(SOCKET_NAME)
        finally:
            os.umask(old_umask)
            os.fchdir(here)
            os.close(here)
        srv.listen(16)
        srv.setblocking(False)

        stop = []
        for sig in (signal.SIGINT, signal.SIGTERM):
            signal.signal(sig, lambda *_: stop.append(True))

        buffers = {}
        greeting = {}
        last_refresh = 0.0
        while not stop:
            if self.hp is None:
                self.connect()

            if self.hp:
                try:
                    self.hp.pump(0)
                except Exception as e:
                    self.drop(str(e))

            # The wait happens here, never inside pump(). mdrConnectionPoll
            # asks the socket for POLLIN|POLLOUT, and an idle socket is always
            # writable, so its timeout never elapses -- passing one just spun
            # this loop on a full core for as long as the headset was
            # connected. select() on the control socket does the waiting
            # instead, and wakes the moment a command lands, so nothing here
            # answers any slower than it did before.
            wait = self.IDLE_WAIT if self.hp else self.RETRY_WAIT
            # Accepted, but has not said what it wants yet. They wait in the
            # select set like everyone else rather than in a read of their own.
            ready, _, _ = select.select(
                [srv] + self.subscribers + list(greeting), [], [], wait)
            dirty = False
            for sock in ready:
                if sock is srv:
                    try:
                        conn, _ = srv.accept()
                    except OSError as e:
                        if e.errno not in (errno.EAGAIN, errno.EWOULDBLOCK):
                            raise
                        continue
                    # Refuse rather than queue past the cap: a local client
                    # holding connections open should hit a wall it can see,
                    # not quietly consume the daemon's descriptors.
                    if len(self.subscribers) + len(greeting) >= MAX_CLIENTS:
                        conn.close()
                        continue
                    conn.setblocking(False)
                    greeting[conn] = time.monotonic() + self.REQUEST_WAIT
                elif sock in greeting:
                    del greeting[sock]
                    if self.serve(sock):
                        dirty = True
                else:
                    if self.serve_subscriber(sock, buffers):
                        dirty = True

            # A client that connects and then says nothing is not a client.
            if greeting:
                now = time.monotonic()
                for conn in [c for c, due in greeting.items() if now > due]:
                    del greeting[conn]
                    conn.close()

            # Nor is one that sends half a command and stops.
            if self.partial:
                now = time.monotonic()
                for conn in [c for c, since in self.partial.items()
                             if now - since > PARTIAL_LINE_WAIT]:
                    self.partial.pop(conn, None)
                    buffers.pop(conn, None)
                    self.drop_subscriber(conn)

            now = time.monotonic()
            # A command's effect should show immediately, not on the next tick.
            if dirty or now - last_refresh >= 0.2:
                last_refresh = now
                self.publish(self.refresh())

        srv.close()
        for conn in list(greeting):
            conn.close()
        for conn in list(self.subscribers):
            self.drop_subscriber(conn)
        for name in (SOCKET_NAME, STATE_NAME):
            try:
                os.unlink(name, dir_fd=self.dirfd)
            except OSError:
                pass
        os.close(self.dirfd)
        self.dirfd = None
        if self.hp:
            self.hp.close()

    def serve_subscriber(self, conn, buffers):
        """A held-open connection: further lines on it are commands."""
        try:
            chunk = conn.recv(4096)
        except OSError:
            self.drop_subscriber(conn)
            return False
        if not chunk:
            self.drop_subscriber(conn)
            return False
        buf = buffers.get(conn, b"") + chunk
        # A command is a short line. Without this, a client that never sends a
        # newline makes the daemon hold everything it has ever sent, and a
        # handful of such connections is all it takes to exhaust memory.
        if len(buf) > MAX_LINE:
            self.drop_subscriber(conn)
            buffers.pop(conn, None)
            return False
        acted = False
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            text = line.decode(errors="replace").strip()
            if not text:
                continue
            reply = self.handle(text)
            acted = True
            try:
                conn.sendall((json.dumps(reply) + "\n").encode())
            except OSError:
                self.drop_subscriber(conn)
                buffers.pop(conn, None)
                return acted
        # Remember when an incomplete line first appeared. A subscriber that
        # sits silent forever is normal and stays; a subscriber holding half a
        # command is the shape this needs to let go of.
        if buf:
            buffers[conn] = buf
            self.partial.setdefault(conn, time.monotonic())
        else:
            buffers.pop(conn, None)
            self.partial.pop(conn, None)
        return acted

    def serve(self, conn):
        """One request from a client that has now said something.

        Nothing waits here. A connection is only handed to this once select
        says it is readable, because the loop is single-threaded: waiting even
        briefly on a client that has gone quiet holds up the MDR pump and every
        subscriber behind it.

        `subscribe` keeps the connection open and turns it into a push channel,
        which is what the bar widget uses so it never has to poll.
        """
        try:
            line = conn.recv(4096).decode(errors="replace").strip()
        except (OSError, UnicodeDecodeError):
            conn.close()
            return False
        if not line:                      # the client hung up
            conn.close()
            return False

        if line == "subscribe":
            conn.setblocking(False)
            self.subscribers.append(conn)
            try:
                conn.sendall((json.dumps({"state": self.state}) + "\n").encode())
            except OSError:
                self.drop_subscriber(conn)
            return False

        with conn:
            reply = self.handle(line)
            if reply.get("ok") and line.split()[:1] != ["status"]:
                reply["state"] = self.refresh()
            try:
                conn.sendall((json.dumps(reply) + "\n").encode())
            except OSError:
                pass
        return reply.get("ok", False)


def main(argv=None):
    """Configuration arrives as arguments, so the unit states it rather than
    the daemon inheriting whatever it was handed."""
    ap = argparse.ArgumentParser(
        prog="mdrctld", description="Hold the Sony MDR control session.")
    ap.add_argument("--mac", default="", metavar="AA:BB:CC:DD:EE:FF",
                    help="pin to one headset; by default it takes whichever "
                         "MDR device is connected")
    ap.add_argument("--build-dir", default=None, metavar="DIR",
                    help="where libmdr's shared objects are, for running out "
                         "of a checkout; installed, they are found already")
    ap.add_argument("--trace", default="", metavar="FILE",
                    help="record every frame, command and publish here")
    args = ap.parse_args(argv)

    global MAC, BUILD, TRACE
    MAC = args.mac
    TRACE = args.trace
    if args.build_dir:
        BUILD = args.build_dir

    if BUSCTL is None:
        sys.exit("busctl not found in " + " or ".join(BUSCTL_CANDIDATES) +
                 " -- install bluez and systemd")
    Daemon().run()


if __name__ == "__main__":
    main()
