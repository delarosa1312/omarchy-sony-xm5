#!/usr/bin/env bash
# Everything that can be checked without headphones on your head.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
status=0

echo "== daemon and protocol (python) =="
python3 -m unittest discover -s tests -q || status=1

echo
echo "== panel logic (node) =="
if command -v node >/dev/null; then
  # mktemp rather than a fixed name under /tmp: a predictable path in a
  # world-writable directory is somebody else's to create first.
  node_log=$(mktemp)
  if node tests/model.test.js > "$node_log" 2>&1; then
    grep -E "^# (tests|pass|fail)" "$node_log"
  else
    cat "$node_log"
    status=1
  fi
  rm -f "$node_log"
else
  echo "node not installed -- skipped"
fi

echo
echo "== plugin manifest and QML =="
# Validate what a clone would actually contain, not the working directory: the
# local build tree under vendor/ is full of symlinks, which a plugin folder may
# not have -- and it is not in git, so nobody else ever sees it.
export_dir=$(mktemp -d)
git -C "$ROOT" ls-files -z | tar --null -T - -cf - -C "$ROOT" 2>/dev/null | tar -xf - -C "$export_dir"
omarchy plugin validate "$export_dir" && echo "manifest ok" || status=1
rm -rf "$export_dir"
# Any file with an IpcHandler makes qmllint exit 255, Omarchy's own included,
# so only the panel is linted -- the one where a mistake would be ours.
qmllint -I "${OMARCHY_PATH:-/usr/share/omarchy}/shell" "$ROOT/Panel.qml" \
  && echo "Panel.qml lints clean" || status=1

echo
echo "== version agreement =="
# Three files carry the version and nothing made them agree. A release that
# bumps one and forgets another builds the wrong tag or lists the wrong
# version, and neither failure shows up until somebody installs it.
manifest_version=$(python3 -c "import json;print(json.load(open('$ROOT/manifest.json'))['version'])")
pkgbuild_version=$(sed -n 's/^pkgver=//p' "$ROOT/PKGBUILD")
srcinfo_version=$(sed -n 's/^[[:space:]]*pkgver = //p' "$ROOT/.SRCINFO")
if [ "$manifest_version" = "$pkgbuild_version" ] && [ "$manifest_version" = "$srcinfo_version" ]; then
  echo "manifest.json, PKGBUILD and .SRCINFO all say $manifest_version"
else
  echo "version mismatch: manifest.json=$manifest_version PKGBUILD=$pkgbuild_version .SRCINFO=$srcinfo_version" >&2
  status=1
fi

# The upstream commit is spelled out in full everywhere it is used, so that a
# static reader can verify the pin. That buys four copies of it, and four
# copies drift. There is exactly one correct answer, so check them against it.
mdrcommit=$(sed -n 's/^_mdrcommit=//p' "$ROOT/PKGBUILD")
if [[ ! $mdrcommit =~ ^[0-9a-f]{40}$ ]]; then
  echo "PKGBUILD _mdrcommit is not a full 40-character SHA: $mdrcommit" >&2
  status=1
else
  # The PKGBUILD is the only thing that fetches upstream now, so the copies that
  # could drift are its source array and the .SRCINFO generated from it.
  stray=$(grep -ohE '\b[0-9a-f]{40}\b' "$ROOT/PKGBUILD" "$ROOT/.SRCINFO" \
          | sort -u | grep -v "^$mdrcommit$" || true)
  if [ -n "$stray" ]; then
    echo "a file pins an upstream commit the PKGBUILD does not: $stray" >&2
    status=1
  else
    echo "upstream pinned to $mdrcommit in PKGBUILD and .SRCINFO"
  fi
fi

# The PKGBUILD builds a tag, not the checkout, so a tag that does not exist
# turns `makepkg` into a clone failure for whoever follows the README. A
# warning rather than a failure: between bumping the version and cutting the
# tag there is always a moment where this is legitimately true, and that moment
# is the middle of a release, which is a bad time for the tests to go red.
if git -C "$ROOT" rev-parse -q --verify "refs/tags/v$manifest_version" >/dev/null; then
  tagged=$(git -C "$ROOT" rev-parse "refs/tags/v$manifest_version^{commit}")
  head=$(git -C "$ROOT" rev-parse HEAD)
  if [ "$tagged" = "$head" ]; then
    echo "tag v$manifest_version is at HEAD"
  else
    echo "warning: tag v$manifest_version is not at HEAD -- makepkg would build ${tagged:0:7}, not your checkout" >&2
  fi
else
  echo "warning: no tag v$manifest_version yet -- cut it before anyone runs makepkg" >&2
fi

exit $status
